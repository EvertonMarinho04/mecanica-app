# Copie este arquivo para ".env" e ajuste os valores antes de rodar o backend.

# Senha do administrador (texto puro). É transformada em hash automaticamente
# na primeira vez que o sistema iniciar. Troque para uma senha forte.
ADMIN_PASSWORD=troque-esta-senha

# Chave secreta usada para assinar o token de login do administrador.
# Gere uma aleatória, por exemplo com: openssl rand -hex 32
SECRET_KEY=troque-esta-chave-secreta

# Tempo (em minutos) que o login do administrador fica valido.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# String de conexao do banco de dados.
# Em desenvolvimento local (padrao): SQLite em arquivo, nao precisa instalar nada.
# Em producao (Render): use um PostgreSQL gratuito, por exemplo do Neon (neon.tech).
# A string do Neon tem esse formato (troque pelos dados reais do seu banco):
# postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/mecanica?sslmode=require
DATABASE_URL=sqlite:///./mecanica.db

# Origem(ns) permitidas para o frontend acessar a API (separadas por virgula).
# Em desenvolvimento local, o padrao abaixo funciona.
# Em producao, troque pela URL publica do frontend na Vercel, por exemplo:
# CORS_ORIGINS=https://mecanica-app.vercel.app
CORS_ORIGINS=http://localhost:5173
